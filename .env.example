# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
BOT_TOKEN=

# Optional. During development, set this to your test server's ID so slash commands
# register instantly. Leave it empty in production to register commands globally
# (Discord can take up to an hour to roll those out).
DEV_GUILD_ID=

# Optional overrides.
# ZBORLE_TIMEZONE=Europe/Skopje
# ZBORLE_DB_PATH=db/zborle.db
